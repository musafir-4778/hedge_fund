[Unit]
Description=Indian Wealth Management Autonomous Agent Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Hedge_fund
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/ubuntu/Hedge_fund/.env
ExecStart=/home/ubuntu/Hedge_fund/.venv/bin/python daemon.py --daemon
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

